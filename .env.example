# ===== 智绘 AI · Diagram Studio 配置 =====
# 复制本文件为 .env 并填入你的配置：cp .env.example .env

# DeepSeek API Key（必填，https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-api-key

# 模型：deepseek-v4-pro（质量优先）/ deepseek-v4-flash（速度优先）
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI 兼容 API 地址（可指向本地 Ollama / vLLM 网关实现全离线）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次生成 token 上限
MAX_TOKENS=8192

# 服务端口
PORT=3210
